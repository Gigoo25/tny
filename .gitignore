# GGUF weights and ZIM corpora now live in ${XDG_DATA_HOME:-~/.local/share}/tny (F77),
# not here — these two rules only matter for a checkout that predates the move
models/
zim/
# Cargo build output — 1,000+ files, all reproducible from Cargo.lock
target/

# 116 MB scorer cache — regenerable with `bun bench/sweep.mjs --rebuild`, and over
# GitHub's 100 MB hard limit
bench/.sweep-cache.json

# Retrieved contexts for the no-model arm — regenerable with
# `bun bench/extract-cli.mjs --rebuild` (~50 s), and it carries scraped page text
bench/.contexts.json
bench/.embeds.json
bench/.shortlists.json
bench/.answers-08b-inst.json
bench/.answers-4b.json
